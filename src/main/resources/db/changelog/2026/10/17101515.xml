<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="002-pricing-settings" author="kacper">
        <createTable tableName="pricing_settings">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true"/>
            </column>
            <column name="default_margin_percent" type="NUMERIC(5,2)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <sql>ALTER TABLE pricing_settings ADD CONSTRAINT chk_default_margin
            CHECK (default_margin_percent >= 0 AND default_margin_percent &lt; 100)</sql>

        <!-- wartość startowa, właściciel zmienia ją z panelu -->
        <insert tableName="pricing_settings">
            <column name="id" valueNumeric="1"/>
            <column name="default_margin_percent" valueNumeric="50.00"/>
        </insert>
    </changeSet>

    <changeSet id="002-menu-item-margin" author="kacper">
        <addColumn tableName="menu_item">
            <column name="margin_percent" type="NUMERIC(5,2)"/>
        </addColumn>
        <sql>ALTER TABLE menu_item ADD CONSTRAINT chk_menu_item_margin
            CHECK (margin_percent IS NULL OR (margin_percent >= 0 AND margin_percent &lt; 100))</sql>
    </changeSet>
</databaseChangeLog>